# Copy this file to .env.local and fill in the values.
# The landing page itself runs with NONE of these set.
# Each block below unlocks one feature.

# Public URL of the site (used for OpenGraph metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ───────────────────────────────────────────────────────────────
# 1) DATABASE — stores contact-form messages so they show in /admin
#    Local Docker: `npm run db` starts one on localhost:5434 (see below).
#    Cloud: free Postgres from https://neon.tech → "Connect" → copy the
#    connection string, then run schema.sql once in Neon's SQL Editor.
# ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://upright:upright@localhost:5434/upright

# Only for `npm run prod` (docker-compose.prod.yml): password for the
# Postgres container. Generate one the same way as AUTH_SECRET below.
POSTGRES_PASSWORD=


# ───────────────────────────────────────────────────────────────
# 2) ADMIN LOGIN — protects /admin
#    Use a long random password (20+ chars). AUTH_SECRET signs the login
#    cookie — generate both with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Changing AUTH_SECRET logs every admin out (useful if a laptop is lost).
# ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=


# ───────────────────────────────────────────────────────────────
# 3) EMAIL NOTIFICATIONS — emails you a copy of each message (Resend)
#    Free account at https://resend.com -> API Keys -> Create API Key.
#    While testing, RESEND_FROM_EMAIL can stay as onboarding@resend.dev
#    (it only delivers to the email you signed up to Resend with).
#    For production, verify your domain in Resend -> Domains and use
#    e.g. website@uprightsystems.com
# ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=


# ───────────────────────────────────────────────────────────────
# 4) SPAM PROTECTION (optional) — Cloudflare Turnstile CAPTCHA on the form
#    Free: https://dash.cloudflare.com → Turnstile → Add site.
#    Without these the form still has a honeypot + rate limiting.
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
